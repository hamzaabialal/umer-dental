# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# 32+ random characters; signs login sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Public URL used in WhatsApp / calendar links sent to patients (e.g. https://clinic.umardental.pk)
APP_URL="http://localhost:3000"

# ---- Website booking API (POST /api/public/bookings) ----
# Website origins allowed to post the booking form, comma-separated (no trailing slash)
BOOKING_ALLOWED_ORIGINS="https://umardental.pk,https://www.umardental.pk"
# Optional: lets a server (not a browser) post bookings with header X-Api-Key. Generate with: openssl rand -hex 24
BOOKING_API_KEY=""

# WhatsApp number that gets "new booking" alerts (Dr. Umar)
NOTIFY_WHATSAPP_TO="03310009851"
# Option A, quickest: CallMeBot (see README for the 1-minute setup)
CALLMEBOT_APIKEY=""
# Option B, official: Meta WhatsApp Cloud API with an approved template (used instead of CallMeBot when set)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
